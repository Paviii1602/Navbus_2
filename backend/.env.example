# NavBus Backend Environment Configuration
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────

# Port for local development (Render/Railway set this automatically)
PORT=5000

# Secret key for sessions and cookies - CHANGE IN PRODUCTION!
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-in-production

# Enable debug mode (false in production)
FLASK_DEBUG=false

# ─────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────

# SQLite (default, for development)
DATABASE_URL=sqlite:///navbus.db

# PostgreSQL (for production on Render/Railway)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─────────────────────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────────────────────

# Enable/disable rate limiting (true recommended for production)
RATELIMIT_ENABLED=true

# ─────────────────────────────────────────────────────────────
# CORS (Optional - defaults to allow all)
# ─────────────────────────────────────────────────────────────

# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ─────────────────────────────────────────────────────────────
# Logging (Optional)
# ─────────────────────────────────────────────────────────────

# LOG_LEVEL=INFO
# LOG_FILE=navbus.log
